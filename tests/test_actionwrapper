import numpy as np
import gymnasium as gym
from gymnasium import spaces

from jengaa import environment as E

class DummyEnv(gym.Env):
    def __init__(self):
        super().__init__()
        self.curriculum_level = 2
        self.action_space = spaces.Discrete(1)
        self.observation_space = spaces.Box(low=-1.0, high=1.0, shape=(1,), dtype=np.float32)

    def set_curriculum_level(self, level: int):
        self.curriculum_level = level

    def reset(self, seed=None, options=None):
        return np.zeros((1,), dtype=np.float32), {}

    def step(self, action):
        return np.zeros((1,), dtype=np.float32), 0.0, False, False, {}

def test_actionwrapper_maps_and_clamps():
    env = DummyEnv()
    w = E.ActionWrapper(env, n_blocks=5)

    
    a = np.array([4, 0, 1, 2, 2], dtype=np.int64)  
    out = w.action(a)

    assert out["block"] == 1
    assert out["force"].shape == (3,)
    assert out["force"].dtype == np.float32
    assert out["angular"].shape == (1,)
    assert out["angular"].dtype == np.float32

   
    assert np.all(np.abs(out["force"]) <= E.MAX_MOVEMENT_DISTANCE + 1e-6)
    assert abs(out["angular"][0]) <= (np.pi / 4) + 1e-6
